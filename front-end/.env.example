# The browser always uses same-origin /api routes. Only Next.js calls this backend.
ATLAS_API_BASE_URL=http://localhost:8000
# No token required. Override with your own MapLibre style.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# Explicit demo data, never an automatic fallback for failed API calls.
NEXT_PUBLIC_USE_MOCK_API=true
# Long-running external API requests remain visibly in progress (default: 90 seconds).
NEXT_PUBLIC_API_TIMEOUT_MS=90000
# Optional replacement: complete WGS84 GeoJSON census collection, normalized to our contract.
# ATLAS_CENSUS_GEOJSON_URL=http://localhost:8000/api/geo/census-sections
# Development-only latency simulation, in milliseconds.
NEXT_PUBLIC_MOCK_LATENCY_MS=1200
